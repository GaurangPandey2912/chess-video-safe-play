{
  "manifest_version": 3,
  "name": "Chess Video — Safe Play",
  "version": "1.1",
  "description": "1-on-1 video chat for chess.com with friends, automatic sensitive content monitoring.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.chess.com/*",
    "https://chess.com/*",
    "http://localhost:3000/*"
  ],
  "web_accessible_resources": [{
    "resources": ["lib/peerjs.min.js", "auth-callback.html"],
    "matches": ["https://www.chess.com/*", "https://chess.com/*"]
  }],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.chess.com/*", "https://chess.com/*"],
      "js": ["lib/peerjs.min.js", "content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
